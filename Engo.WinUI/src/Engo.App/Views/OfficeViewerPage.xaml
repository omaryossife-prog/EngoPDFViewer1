<Page
    x:Class="Engo.App.Views.OfficeViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">
    <Grid Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button
                x:Name="PreviousPageButton"
                Grid.Column="0"
                Content="السابق"
                Click="PreviousPageButton_Click"
                Visibility="Collapsed" />
            <Button
                x:Name="NextPageButton"
                Grid.Column="1"
                Content="التالي"
                Click="NextPageButton_Click"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="PageLabelText"
                Grid.Column="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="DocumentNameText"
                Grid.Column="3"
                VerticalAlignment="Center"
                MaxWidth="340"
                TextTrimming="CharacterEllipsis"
                Opacity="0.72" />
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True"
            Severity="Error"
            Title="تعذّر عرض مستند Office" />

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <WebView2
                    x:Name="OfficeWebView"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    NavigationStarting="OfficeWebView_NavigationStarting" />
                <ProgressRing
                    x:Name="LoadingRing"
                    IsActive="False"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
