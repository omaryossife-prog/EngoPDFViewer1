<Page
    x:Class="Engo.App.Views.PdfViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <Button
                x:Name="PreviousButton"
                Content="السابق"
                Click="PreviousButton_Click"
                IsEnabled="False" />
            <Button
                x:Name="NextButton"
                Content="التالي"
                Click="NextButton_Click"
                IsEnabled="False" />
            <TextBlock
                x:Name="PageCounter"
                VerticalAlignment="Center"
                Margin="6,0"
                Text="لم يتم فتح ملف" />
            <TextBox
                x:Name="PageNumberTextBox"
                Width="72"
                PlaceholderText="رقم الصفحة"
                VerticalAlignment="Center" />
            <Button
                Content="انتقال"
                Click="GoToPageButton_Click" />
            <Rectangle
                Width="1"
                Height="28"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="6,0" />
            <TextBox
                x:Name="SearchTextBox"
                Width="230"
                PlaceholderText="ابحث داخل المستند"
                VerticalAlignment="Center" />
            <Button
                Content="بحث"
                Click="SearchButton_Click" />
            <Button
                Content="استخراج نص الصفحة"
                Click="ExtractCurrentPageTextButton_Click" />
            <ComboBox
                x:Name="OcrLanguageComboBox"
                Width="115"
                SelectedIndex="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="لغة التعرف الضوئي">
                <ComboBoxItem Content="العربية" Tag="ar" />
                <ComboBoxItem Content="English" Tag="en-US" />
            </ComboBox>
            <Button
                Content="OCR للصفحة"
                Click="RecognizePageTextButton_Click" />
            <Rectangle
                Width="1"
                Height="28"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="6,0" />
            <Button Content="−" ToolTipService.ToolTip="تصغير" Click="ZoomOutButton_Click" />
            <Button Content="100%" x:Name="ResetZoomButton" Click="ResetZoomButton_Click" />
            <Button Content="+" ToolTipService.ToolTip="تكبير" Click="ZoomInButton_Click" />
            <Button Content="ملاءمة الصفحة" Click="FitPageButton_Click" />
            <Button Content="ملاءمة العرض" Click="FitWidthButton_Click" />
            <TextBlock
                x:Name="ZoomStatusText"
                Text="100%"
                VerticalAlignment="Center"
                Opacity="0.72" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True"
            Severity="Error"
            Title="حدث خطأ" />

        <Grid Grid.Row="2" ColumnDefinitions="300,*" ColumnSpacing="12">
            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBlock
                        Text="نتائج البحث"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="SearchResultSummary"
                        Grid.Row="1"
                        Text="اكتب كلمة أو عبارة للبحث داخل الملف."
                        Opacity="0.72"
                        TextWrapping="Wrap" />
                    <ListView
                        x:Name="SearchResultsList"
                        Grid.Row="2"
                        SelectionMode="Single"
                        DisplayMemberPath="Snippet"
                        SelectionChanged="SearchResultsList_SelectionChanged" />
                </Grid>
            </Border>

            <Grid
                Grid.Column="1"
                RowDefinitions="*,Auto"
                RowSpacing="8">
                <Border
                    Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <ScrollViewer
                            x:Name="PdfScrollViewer"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            ZoomMode="Enabled"
                            MinZoomFactor="0.1"
                            MaxZoomFactor="4"
                            ViewChanged="PdfScrollViewer_ViewChanged">
                            <Image
                                x:Name="PageImage"
                                HorizontalAlignment="Center"
                                Stretch="Uniform" />
                        </ScrollViewer>
                        <ProgressRing
                            x:Name="LoadingRing"
                            IsActive="False"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Expander
                    x:Name="PageTextExpander"
                    Grid.Row="1"
                    Header="النص المستخرج من الصفحة"
                    IsExpanded="False">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <ScrollViewer MaxHeight="180">
                            <TextBlock
                                x:Name="ExtractedPageText"
                                Text="استخدم زر استخراج نص الصفحة لعرض النص القابل للاستخراج."
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</Page>
