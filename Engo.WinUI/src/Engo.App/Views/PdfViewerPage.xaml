<Page
    x:Class="Engo.App.Views.PdfViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <StackPanel
            x:Name="PdfTopToolbar"
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <Button
                x:Name="PreviousButton"
                Content="السابق"
                Click="PreviousButton_Click"
                IsEnabled="False" />
            <Button
                x:Name="NextButton"
                Content="التالي"
                Click="NextButton_Click"
                IsEnabled="False" />
            <TextBlock
                x:Name="PageCounter"
                VerticalAlignment="Center"
                Margin="6,0"
                Text="لم يتم فتح ملف" />
            <TextBox
                x:Name="PageNumberTextBox"
                Width="72"
                PlaceholderText="رقم الصفحة"
                VerticalAlignment="Center" />
            <Button
                Content="انتقال"
                Click="GoToPageButton_Click" />
            <Rectangle
                Width="1"
                Height="28"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="6,0" />
            <TextBox
                x:Name="SearchTextBox"
                Width="230"
                PlaceholderText="ابحث داخل المستند"
                VerticalAlignment="Center" />
            <Button
                Content="بحث"
                Click="SearchButton_Click" />
            <Button
                Content="استخراج نص الصفحة"
                Click="ExtractCurrentPageTextButton_Click" />
            <ComboBox
                x:Name="OcrLanguageComboBox"
                Width="115"
                SelectedIndex="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="لغة التعرف الضوئي">
                <ComboBoxItem Content="العربية" Tag="ar" />
                <ComboBoxItem Content="English" Tag="en-US" />
            </ComboBox>
            <Button
                Content="OCR للصفحة"
                Click="RecognizePageTextButton_Click" />
            <Rectangle
                Width="1"
                Height="28"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="6,0" />
            <Button Content="−" ToolTipService.ToolTip="تصغير" Click="ZoomOutButton_Click" />
            <Button Content="100%" x:Name="ResetZoomButton" Click="ResetZoomButton_Click" />
            <Button Content="+" ToolTipService.ToolTip="تكبير" Click="ZoomInButton_Click" />
            <Button Content="ملاءمة الصفحة" Click="FitPageButton_Click" />
            <Button Content="ملاءمة العرض" Click="FitWidthButton_Click" />
            <Button
                x:Name="FullPageModeButton"
                Content="عرض كامل"
                ToolTipService.ToolTip="إخفاء الأدوات واللوحات لزيادة مساحة القراءة"
                Click="FullPageModeButton_Click" />
            <TextBlock
                x:Name="ZoomStatusText"
                Text="100%"
                VerticalAlignment="Center"
                Opacity="0.72" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True"
            Severity="Error"
            Title="حدث خطأ" />

        <Border
            x:Name="AnnotationToolbarBorder"
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock Text="أداة التعليق" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="AnnotationToolComboBox"
                    Width="145"
                    SelectedIndex="0"
                    SelectionChanged="AnnotationToolComboBox_SelectionChanged">
                    <ComboBoxItem Content="تصفح وتحريك" Tag="Browse" />
                    <ComboBoxItem Content="تظليل" Tag="Highlight" />
                    <ComboBoxItem Content="قلم حر" Tag="Freehand" />
                    <ComboBoxItem Content="مستطيل" Tag="Rectangle" />
                    <ComboBoxItem Content="ممحاة" Tag="Eraser" />
                </ComboBox>
                <TextBlock Text="اللون" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="AnnotationColorComboBox"
                    Width="105"
                    SelectedIndex="0">
                    <ComboBoxItem Content="أصفر" Tag="Yellow" />
                    <ComboBoxItem Content="أحمر" Tag="Red" />
                    <ComboBoxItem Content="أزرق" Tag="Blue" />
                    <ComboBoxItem Content="أخضر" Tag="Green" />
                </ComboBox>
                <TextBlock Text="السُمك" VerticalAlignment="Center" />
                <Slider
                    x:Name="AnnotationLineWidthSlider"
                    Width="100"
                    Minimum="1"
                    Maximum="8"
                    Value="3"
                    StepFrequency="0.5" />
                <Button
                    Content="تراجع"
                    Click="UndoLastAnnotationButton_Click" />
                <Button
                    Content="حفظ نسخة PDF"
                    Click="SaveAnnotatedCopyButton_Click" />
                <TextBlock
                    x:Name="AnnotationStatusText"
                    VerticalAlignment="Center"
                    Opacity="0.72"
                    Text="اختر أداة للتعليق، ثم ارسم على الصفحة." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PdfSideColumn" Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="PdfSidePanelBorder"
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
                <TabView
                    x:Name="PdfSideTabs"
                    IsAddTabButtonVisible="False">
                    <TabView.TabItems>
                        <TabViewItem Header="نتائج البحث">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <TextBlock
                                    x:Name="SearchResultSummary"
                                    Text="اكتب كلمة أو عبارة للبحث داخل الملف."
                                    Opacity="0.72"
                                    TextWrapping="Wrap" />
                                <ListView
                                    x:Name="SearchResultsList"
                                    Grid.Row="1"
                                    SelectionMode="Single"
                                    DisplayMemberPath="Snippet"
                                    SelectionChanged="SearchResultsList_SelectionChanged" />
                            </Grid>
                        </TabViewItem>
                        <TabViewItem Header="الصفحات">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                <TextBlock
                                    x:Name="ThumbnailSummary"
                                    Text="صور مصغرة للصفحات القريبة من الصفحة الحالية."
                                    Opacity="0.72"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <Button
                                        x:Name="PreviousThumbnailRangeButton"
                                        Content="المجموعة السابقة"
                                        Click="PreviousThumbnailRangeButton_Click"
                                        IsEnabled="False" />
                                    <TextBlock
                                        x:Name="ThumbnailRangeText"
                                        VerticalAlignment="Center"
                                        Text="—" />
                                    <Button
                                        x:Name="NextThumbnailRangeButton"
                                        Content="المجموعة التالية"
                                        Click="NextThumbnailRangeButton_Click"
                                        IsEnabled="False" />
                                </StackPanel>
                                <ListView
                                    x:Name="PageThumbnailsList"
                                    Grid.Row="2"
                                    SelectionMode="Single"
                                    IsItemClickEnabled="True"
                                    ItemClick="PageThumbnailsList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                Spacing="5"
                                                Margin="4">
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="3">
                                                    <Image
                                                        Source="{Binding Thumbnail}"
                                                        Width="150"
                                                        Height="190"
                                                        Stretch="Uniform" />
                                                </Border>
                                                <TextBlock
                                                    Text="{Binding PageLabel}"
                                                    HorizontalAlignment="Center"
                                                    FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </TabViewItem>
                    </TabView.TabItems>
                </TabView>
            </Border>

            <Grid
                Grid.Column="1"
                RowDefinitions="*,Auto"
                RowSpacing="8">
                <Border
                    Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <ScrollViewer
                            x:Name="PdfScrollViewer"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            ZoomMode="Enabled"
                            MinZoomFactor="0.1"
                            MaxZoomFactor="4"
                            ViewChanged="PdfScrollViewer_ViewChanged">
                            <Grid
                                x:Name="PdfPageSurface"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Image
                                    x:Name="PageImage"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform" />
                                <Canvas
                                    x:Name="AnnotationCanvas"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    PointerPressed="AnnotationCanvas_PointerPressed"
                                    PointerMoved="AnnotationCanvas_PointerMoved"
                                    PointerReleased="AnnotationCanvas_PointerReleased"
                                    PointerCaptureLost="AnnotationCanvas_PointerCaptureLost" />
                            </Grid>
                        </ScrollViewer>
                        <Button
                            x:Name="ExitFullPageModeButton"
                            Content="إنهاء العرض الكامل"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="12"
                            Visibility="Collapsed"
                            Click="FullPageModeButton_Click" />
                        <ProgressRing
                            x:Name="LoadingRing"
                            IsActive="False"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Expander
                    x:Name="PageTextExpander"
                    Grid.Row="1"
                    Header="النص المستخرج من الصفحة"
                    IsExpanded="False">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <ScrollViewer MaxHeight="180">
                            <TextBlock
                                x:Name="ExtractedPageText"
                                Text="استخدم زر استخراج نص الصفحة لعرض النص القابل للاستخراج."
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</Page>
