<Page
    x:Class="Engo.App.Views.ImageViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <Button Content="تصغير" Click="ZoomOutButton_Click" />
            <Button Content="100%" Click="ResetZoomButton_Click" />
            <Button Content="تكبير" Click="ZoomInButton_Click" />
            <TextBlock
                x:Name="ZoomStatusText"
                Text="100%"
                VerticalAlignment="Center"
                Opacity="0.72" />
            <TextBlock
                x:Name="ImageDimensionsText"
                VerticalAlignment="Center"
                Margin="12,0,0,0"
                Opacity="0.72" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True"
            Severity="Error"
            Title="تعذّر فتح الصورة" />

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <ScrollViewer
                    x:Name="ImageScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ZoomMode="Enabled"
                    MinZoomFactor="0.1"
                    MaxZoomFactor="8"
                    ViewChanged="ImageScrollViewer_ViewChanged">
                    <Image
                        x:Name="DocumentImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </ScrollViewer>
                <ProgressRing
                    x:Name="LoadingRing"
                    IsActive="False"
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
